# Copy this file to ".env" and edit it. NEVER upload ".env" to GitHub.

# "local" = keep encrypted blocks in the local storage folder (original behaviour)
# "s3"    = keep encrypted blocks in an S3 bucket
STORAGE_BACKEND=local

# ---- Only needed when STORAGE_BACKEND=s3 ----
S3_BUCKET=my-secure-chunks-bucket
AWS_REGION=ap-south-1

# Local free S3 emulator ONLY. Delete or leave empty when using real AWS.
# S3_ENDPOINT_URL=http://127.0.0.1:5001
# These dummy values are for the emulator ONLY. Never put real AWS keys in this file.
# AWS_ACCESS_KEY_ID=testing
# AWS_SECRET_ACCESS_KEY=testing

# Optional
# FLASK_SECRET_KEY=any-long-random-text
# FERNET_KEY=
